{
  "name": "connect-anything",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "recipes/*"],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "npm test --workspaces --if-present",
    "budget": "npm run budget -w apps/web",
    "e2e": "npm run e2e -w apps/web",
    "e2e:visual": "npm run e2e:visual -w apps/web",
    "e2e:update": "npm run e2e:update -w apps/web",
    "lighthouse": "npm run lighthouse -w apps/web"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
