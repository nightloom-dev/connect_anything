# The simulator's settings. Copy to crates/sim/.env (compose and systemd read it) and never commit the copy.

# Mainnet RPC that serves getMultipleAccounts, such as Helius. Empty means the public endpoint, which rate-limits.
SOLANA_RPC_URL=

# The same value as SIM_TOKEN in apps/web/.env. Empty lets anyone who can reach the port use the simulator.
# To make one: openssl rand -hex 32
SIM_TOKEN=

# Without Docker only: the address and port to listen on. Defaults to 127.0.0.1 and 8790.
# SIM_HOST=127.0.0.1
# SIM_PORT=8790

# Log level, for example sim=debug
# RUST_LOG=sim=info
