# The simulator's settings. Copy to crates/sim/.env (compose and systemd read it), never commit the copy.

# Mainnet RPC with getMultipleAccounts, such as Helius. Empty means the public endpoint, which rate-limits.
SOLANA_RPC_URL=

# The same value as SIM_TOKEN in apps/web/.env. Empty lets anyone who reaches the port use the simulator.
# For example: openssl rand -hex 32
SIM_TOKEN=

# Without Docker only: where to listen. Defaults to 127.0.0.1 and 8790.
# SIM_HOST=127.0.0.1
# SIM_PORT=8790

# Log level, for example sim=debug
# RUST_LOG=sim=info
