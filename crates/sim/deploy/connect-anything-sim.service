# The simulator under systemd, without Docker. See crates/sim/README.md:
#   install -m 755 target/release/sim /usr/local/bin/connect-anything-sim
#   install -m 600 -D crates/sim/.env /etc/connect-anything/sim.env
#   install -m 644 crates/sim/deploy/connect-anything-sim.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now connect-anything-sim
[Unit]
Description=Connect Anything simulator (crates/sim)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/connect-anything-sim
EnvironmentFile=/etc/connect-anything/sim.env
Restart=on-failure
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryMax=2G
# Not MemoryDenyWriteExecute: the program runtime may compile programs to machine code at run time.

[Install]
WantedBy=multi-user.target
