# The web app's settings. Copy to apps/web/.env and never commit the copy. See "Run from zero" in README.md.

# Required: your Aurora API key from https://studio.aurora.dev. It stays on the server and never reaches the browser
AURORA_KEY=
CONNECT_API_URL=https://intents-connect-api.aurora.dev

# The simulator service (crates/sim) behind /api/simulate and the legacy IDL converter. SIM_TOKEN must match the one in
# crates/sim/.env. Without SIM_URL the simulator shows as offline
SIM_URL=
SIM_TOKEN=

# Mainnet RPC. Empty means the public endpoint, which rate-limits
SOLANA_RPC_URL=

# The site's public address, the same as PUBLIC_URL of apps/watch. The example watcher alert on the landing page links
# there, so a page opened on localhost still shows the public address. Empty means the address the page is opened at
VITE_PUBLIC_URL=
