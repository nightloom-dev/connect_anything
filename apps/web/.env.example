AURORA_KEY=
CONNECT_API_URL=https://intents-connect-api.aurora.dev

# The service of role R behind /api/simulate and the legacy IDL converter. Without it the simulator shows as offline
SIM_URL=
SIM_TOKEN=

# Empty means the public mainnet endpoint, which rate-limits
SOLANA_RPC_URL=

# The address the site is served at, as PUBLIC_URL of apps/watch. The example watcher alert on the landing page links
# there, so that a page opened on localhost shows the public address. Empty means the address the page is opened at
VITE_PUBLIC_URL=
