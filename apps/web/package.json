{
  "name": "@connect-anything/web",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --test '{server,src}/**/*.test.ts'",
    "e2e": "playwright test -c e2e/playwright.config.ts --project=desktop --project=mobile --project=dev",
    "e2e:visual": "playwright test -c e2e/playwright.config.ts --project=visual-desktop --project=visual-tablet --project=visual-mobile",
    "e2e:update": "playwright test -c e2e/playwright.config.ts --project=visual-desktop --project=visual-tablet --project=visual-mobile --update-snapshots=changed",
    "e2e:types": "tsc -p e2e/tsconfig.json",
    "e2e:check": "node scripts/check-playwright.ts",
    "budget": "node scripts/bundle-budget.ts dist",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@aurora-is-near/intents-connect": "7.28.0",
    "@aurora-is-near/intents-connect-wallet": "7.28.0",
    "@connect-anything/core": "*",
    "@connect-anything/kamino-rescue": "*",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@headlessui/react": "^2.2.10",
    "@kamino-finance/klend-sdk": "^13.0.6",
    "@reown/appkit": "^1.8.11",
    "@reown/appkit-adapter-ethers": "^1.8.11",
    "@reown/appkit-adapter-solana": "^1.8.11",
    "@solana/kit": "^2.3.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-phantom": "^0.9.28",
    "@solana/wallet-adapter-solflare": "^0.6.32",
    "@solana/web3.js": "^1.99.0",
    "lucide-react": "1.69.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "2.0.8",
    "sugar-high": "2.6.4",
    "viem": "^2.55.19",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@coral-xyz/anchor": "0.32.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "4.3.4",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
